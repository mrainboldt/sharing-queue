<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Query_Rows_Pct__c</fullName>
    <description>Query rows used divided by the Apex query row limit for this execution.</description>
    <formula>IF(Query_Rows_Limit__c &gt; 0, Query_Rows_Used__c / Query_Rows_Limit__c, NULL)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Query Rows %</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
