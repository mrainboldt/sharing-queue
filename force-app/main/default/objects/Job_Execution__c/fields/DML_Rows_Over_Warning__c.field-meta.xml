<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DML_Rows_Over_Warning__c</fullName>
    <description>True when DML Rows % is at or above this Job&apos;s DML Rows Warning %.</description>
    <formula>AND(
  DML_Rows_Limit__c &gt; 0,
  NOT(ISBLANK(Job__r.DML_Rows_Warning_Pct__c)),
  (DML_Rows_Used__c / DML_Rows_Limit__c) &gt;= Job__r.DML_Rows_Warning_Pct__c
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>DML Rows Over Warning</label>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
