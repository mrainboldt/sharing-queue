<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CPU_Time_Pct__c</fullName>
    <description>CPU time used divided by the Apex CPU time limit for this execution.</description>
    <formula>IF(CPU_Time_Limit__c &gt; 0, CPU_Time_Used__c / CPU_Time_Limit__c, NULL)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>CPU Time %</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
