<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DML_Statements_Pct__c</fullName>
    <description>DML statements used divided by the Apex DML statement limit for this execution.</description>
    <formula>IF(DML_Statements_Limit__c &gt; 0, DML_Statements_Used__c / DML_Statements_Limit__c, NULL)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>DML Statements %</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
